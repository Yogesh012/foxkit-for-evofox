{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxkit",
  "identifier": "io.github.yogesh012.foxkit",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "../tools/audio_tap/build.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Foxkit",
        "width": 820,
        "height": 620,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Foxkit",
        "width": 320,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Foxkit contributors",
    "shortDescription": "Unofficial companion app for EvoFox keyboards and mice",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "files": {
        "Helpers/FoxkitAudioTap.app": "../../tools/audio_tap/FoxkitAudioTap.app"
      }
    }
  }
}
