{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxkit",
  "version": "0.1.0",
  "identifier": "local.foxkit.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Foxkit",
        "width": 820,
        "height": 620,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
